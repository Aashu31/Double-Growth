# ---------------------------------------------------------------------------
# Double Growth Platform - environment template
# Copy to .env and fill in real values. Never commit .env.
#
# Anything left blank stays explicitly "not configured": the website shows an
# honest unavailable state and the API returns 503 rather than pretending.
# ---------------------------------------------------------------------------

# Core
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Set to "true" only behind a trusted reverse proxy (Vercel, Render, Nginx).
TRUST_PROXY=false

# Origins
WEB_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database (required for lead capture, orders, newsletter and chat logging)
# Example: postgresql://USER:PASSWORD@localhost:5432/double_growth?schema=public
DATABASE_URL=
# Optional direct (non-pooled) URL used by migrations when the host requires it.
DIRECT_DATABASE_URL=

# AI chatbot (optional; leave blank to show the honest unavailable state)
# AI_PROVIDER currently supports "openai-compatible".
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Application-level monthly request guardrail. Request counts are stored in the
# AiUsage table when a database is configured; otherwise a per-process counter
# is used. This is not a billing meter.
AI_MONTHLY_REQUEST_LIMIT=500

# Payments (optional; leave disabled until a provider is contracted)
PAYMENTS_ENABLED=false
# Hosted payment link template. Placeholders: {orderNumber}, {amountMinor}, {currency}
UPI_PAYMENT_LINK_TEMPLATE=
UPI_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Email notifications (optional; leave blank to record notifications as skipped)
# EMAIL_PROVIDER currently supports "resend".
EMAIL_PROVIDER=
RESEND_API_KEY=
# Verified sender address, e.g. "Double Growth <hello@doublegrowth.in>".
EMAIL_FROM=
# Optional reply-to address for customer replies.
EMAIL_REPLY_TO=
# Internal inbox that receives new lead notifications.
LEAD_NOTIFICATION_EMAIL=
