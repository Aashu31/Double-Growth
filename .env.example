# ---------------------------------------------------------------------------
# Double Growth Platform — environment template
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Core
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Origins
WEB_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database (required for lead capture and orders)
# Example: postgresql://USER:PASSWORD@localhost:5432/double_growth?schema=public
DATABASE_URL=
DIRECT_DATABASE_URL=

# AI chatbot (optional; leave blank to show the honest unavailable state)
# AI_PROVIDER currently supports "openai-compatible".
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Business budget limit in INR. Not enforced by the application in V1.
AI_MONTHLY_BUDGET_INR=2000

# Payments (optional; leave disabled until a provider is contracted)
PAYMENTS_ENABLED=false
# Hosted payment link template. Placeholders: {orderNumber}, {amountMinor}, {currency}
UPI_PAYMENT_LINK_TEMPLATE=
UPI_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Email notifications (optional)
EMAIL_API_KEY=
EMAIL_FROM=
LEAD_NOTIFICATION_EMAIL=
